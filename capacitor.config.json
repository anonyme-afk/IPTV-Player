{
  "appId":   "com.anonyme.iptv",
  "appName": "IPTV Player",
  "webDir":  ".",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext":     true,
    "allowNavigation": [
      "*.github.io",
      "*.githubusercontent.com",
      "raw.githubusercontent.com",
      "iptv-org.github.io",
      "*.m3u8",
      "*.m3u",
      "*.ts"
    ]
  },
  "android": {
    "allowMixedContent":    true,
    "captureInput":         true,
    "webContentsDebuggingEnabled": false,
    "backgroundColor":      "#070a0f",
    "initialFocus":         true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor":    "#070a0f",
      "showSpinner":        false,
      "androidScaleType":   "CENTER_INSIDE"
    }
  }
}
